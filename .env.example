# Vercel environment variables
# Add these in the Vercel project settings (Settings → Environment Variables)

# URL of your running openai-oauth bridge.
# The bridge must be reachable from Vercel serverless functions.
# Example: https://your-bridge.example.com
# For local testing with bridge: http://127.0.0.1:10531
OPENAI_OAUTH_BRIDGE_URL=

# Default model used when the client does not send one.
# Codex-supported models: gpt-5.6-luna, gpt-5.6-terra, gpt-5.6-sol, gpt-5.4-mini
CHAT_MODEL=gpt-5.6-luna
IMAGE_MODEL=gpt-image-2
